server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # En el cluster el Ingress ya manda /api al backend y esta regla no se usa.
    # Sirve para docker compose y para probar el contenedor solo.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Los archivos con hash en el nombre no cambian nunca: se cachean un año.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Cualquier otra ruta la resuelve React Router.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
